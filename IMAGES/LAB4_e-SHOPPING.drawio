          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle Activity Diagram – Quy trình đặt hàng\n\nskinparam shadowing false\nskinparam backgroundColor White\nskinparam ArrowColor Black\nskinparam activity {\n    BackgroundColor White\n    BorderColor Black\n    DiamondBackgroundColor White\n    DiamondBorderColor Black\n    FontColor Black\n    StartColor Black\n    EndColor Black\n    RoundCorner 20\n}\n\nstart\n\n:Khách hàng xem sản phẩm;\n:Chọn sản phẩm;\n:Thêm vào giỏ hàng;\n\nif (Tiếp tục mua?) then (Có)\n    :Xem thêm sản phẩm;\n    :Thêm vào giỏ hàng;\nelse (Không)\n    :Xem giỏ hàng;\nendif\n\n:Cập nhật số lượng;\n:Xóa sản phẩm nếu cần;\n\nif (Đã đăng nhập?) then (Có)\nelse (Chưa)\n    :Đăng nhập;\n\n    if (Có tài khoản?) then (Có)\n    else (Không)\n        :Đăng ký tài khoản;\n        :Đăng nhập;\n    endif\nendif\n\n:Nhập thông tin người nhận;\n:Chọn phương thức giao hàng;\n:Tính tiền hàng;\n:Tính phí giao hàng;\n\nif (Tổng tiền &gt;= 5.000.000?) then (Có)\n    :Miễn phí giao nhanh trong ngày;\nelse (Không)\n    if (Tổng tiền &gt;= 1.000.000?) then (Có)\n        :Miễn phí giao nhanh;\n    else (Không)\n        :Tính phí giao hàng;\n    endif\nendif\n\n:Nhập thông tin thẻ;\n:Kiểm tra thanh toán;\n\nif (Thanh toán thành công?) then (Có)\n    :Tạo đơn hàng;\n    :Lưu đơn hàng;\n    :Lưu chi tiết đơn hàng;\n    :Lưu giao dịch thanh toán;\n    :Hiển thị xác nhận;\nelse (Không)\n    :Thông báo thanh toán thất bại;\nendif\n\nstop\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="w1RjHFdL7Ps-hPTD1bQb-165">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
