        <UserObject label="Sequence Diagram – Thêm sản phẩm vào giỏ" plantUmlId="title_29" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;" plantUmlBaseValue="Sequence Diagram – Thêm sản phẩm vào giỏ" id="w1RjHFdL7Ps-hPTD1bQb-104">
          <mxCell parent="w1RjHFdL7Ps-hPTD1bQb-74" style="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1">
            <mxGeometry height="24" width="334.3369" x="1046.8618535714286" y="640" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle Sequence Diagram – Đặt hàng + thanh toán\n\nskinparam shadowing false\nskinparam backgroundColor White\nskinparam sequenceMessageAlign left\nskinparam responseMessageBelowArrow false\nskinparam ParticipantPadding 25\nskinparam sequence {\n    ArrowColor Black\n    ArrowThickness 1\n    LifeLineBorderColor Gray\n    ParticipantBackgroundColor #E6E6F2\n    ParticipantBorderColor Gray\n    ActorBorderColor Gray\n    ActorBackgroundColor #E6E6F2\n    GroupBorderColor Black\n    GroupBackgroundColor White\n    GroupHeaderFontColor Black\n    GroupFontColor Black\n}\n\nactor \&quot;Khách hàng\&quot; as KH\nboundary \&quot;FrmDatHang\&quot; as FDH\nboundary \&quot;FrmThanhToan\&quot; as FTT\ncontrol \&quot;DonHangService\&quot; as DHS\ncontrol \&quot;ThanhToanService\&quot; as TTS\nentity \&quot;GioHang\&quot; as GH\nentity \&quot;DonHang\&quot; as DH\nentity \&quot;ThanhToan\&quot; as TT\ndatabase \&quot;SQL Server\&quot; as SQL\nparticipant \&quot;Dịch vụ thanh toán\\ntrực tuyến\&quot; as DV\n\nKH -&gt; FDH : Xác nhận đặt hàng\n\nFDH -&gt; DHS : Lấy giỏ hàng\nDHS -&gt; SQL : Đọc GioHang\nSQL --&gt; DHS : Danh sách sản phẩm\n\nKH -&gt; FDH : Nhập người nhận\nKH -&gt; FDH : Chọn phương thức giao hàng\n\nFDH -&gt; DHS : Tính phí giao hàng\nDHS --&gt; FDH : Phí giao hàng\n\nFDH -&gt; FTT : Chuyển sang thanh toán\n\nKH -&gt; FTT : Nhập thông tin thẻ\nKH -&gt; FTT : Xác nhận thanh toán\n\nFTT -&gt; TTS : KiemTraThanhToan()\nTTS -&gt; DV : Gửi yêu cầu kiểm tra\nDV --&gt; TTS : Kết quả thanh toán\n\nalt Thanh toán thành công\n    TTS --&gt; FTT : Thành công\n\n    FTT -&gt; DHS : TaoDonHang()\n\n    DHS -&gt; SQL : Lưu DonHang\n    DHS -&gt; SQL : Lưu ChiTietDonHang\n    DHS -&gt; SQL : Lưu NguoiNhan\n\n    TTS -&gt; SQL : Lưu ThanhToan\n\n    SQL --&gt; DHS : Thành công\n    DHS --&gt; FTT : Tạo đơn thành công\n    FTT --&gt; KH : Hiển thị xác nhận\n\nelse Thanh toán thất bại\n    TTS --&gt; FTT : Thất bại\n    FTT --&gt; KH : Thông báo thanh toán thất bại\nend\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="w1RjHFdL7Ps-hPTD1bQb-105">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
