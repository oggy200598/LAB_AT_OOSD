        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle Sequence Diagram – Thêm sản phẩm vào giỏ\n\nskinparam shadowing false\nskinparam backgroundColor White\nskinparam sequenceMessageAlign left\nskinparam responseMessageBelowArrow false\nskinparam ParticipantPadding 55\n\nskinparam sequence {\n    ArrowColor Black\n    ArrowThickness 1\n    LifeLineBorderColor Gray\n    ParticipantBackgroundColor #E6E6F2\n    ParticipantBorderColor Gray\n    ActorBorderColor Gray\n    ActorBackgroundColor #E6E6F2\n    GroupBorderColor Black\n    GroupBackgroundColor White\n    GroupHeaderFontColor Black\n    GroupFontColor Black\n}\n\nactor \&quot;Khách hàng\&quot; as KH\nboundary \&quot;FrmSanPham\&quot; as FRM\ncontrol \&quot;GioHangService\&quot; as SV\ndatabase \&quot;SQL Server\&quot; as SQL\n\nKH -&gt; FRM : Chọn sản phẩm\nKH -&gt; FRM : Nhập số lượng\nKH -&gt; FRM : Nhấn \&quot;Thêm vào giỏ\&quot;\n\nFRM -&gt; SV : ThemVaoGio(maSP, soLuong)\n\nSV -&gt; SQL : Kiểm tra sản phẩm\nSQL --&gt; SV : Thông tin sản phẩm\n\nSV -&gt; SQL : Kiểm tra giỏ hàng\n\nalt Sản phẩm đã có\n    SV -&gt; SQL : Cập nhật số lượng\nelse Chưa có\n    SV -&gt; SQL : Thêm ChiTietGioHang\nend\n\nSQL --&gt; SV : Thành công\n\nSV --&gt; FRM : Cập nhật giỏ hàng\nFRM --&gt; KH : Thông báo thêm thành công\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="w1RjHFdL7Ps-hPTD1bQb-74">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlId="pl_0" plantUmlBaseStyle="shape=umlLifeline;perimeter=lifelinePerimeter;participant=headless;size=75.49;lifelineMirror=1;dashPattern=5 5;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;sequenceEdgeStyle&quot;,&quot;libavoidRouting&quot;:0,&quot;curved&quot;:0,&quot;rounded&quot;:0};fillColor=none;strokeColor=#808080;strokeWidth=0.5;" plantUmlBaseValue="" id="w1RjHFdL7Ps-hPTD1bQb-75">
