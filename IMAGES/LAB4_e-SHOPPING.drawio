        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\nleft to right direction\nskinparam shadowing false\nskinparam linetype ortho\nskinparam backgroundColor White\nskinparam actorStyle stickman\nskinparam usecase {\n  BackgroundColor White\n  BorderColor Black\n  ArrowColor Black\n}\nskinparam rectangle {\n  BackgroundColor White\n  BorderColor Black\n}\n\nactor \&quot;Khách hàng\&quot; as KH\nactor \&quot;Hệ thống quản lý\\nsản phẩm\&quot; as QLSP\nactor \&quot;Dịch vụ thanh toán\\ntrực tuyến\&quot; as DVTT\n\nrectangle \&quot;Hệ thống e-SHOPPING\&quot; {\n  usecase \&quot;Xem giỏ hàng\&quot; as UC1\n  usecase \&quot;Cập nhật giỏ hàng\&quot; as UC2\n  usecase \&quot;Xóa sản phẩm khỏi giỏ\&quot; as UC3\n  usecase \&quot;Nhập thông tin người nhận\&quot; as UC4\n  usecase \&quot;Tính phí giao hàng\&quot; as UC5\n  usecase \&quot;Chọn phương thức giao hàng\&quot; as UC6\n  usecase \&quot;Đặt hàng\&quot; as UC7\n  usecase \&quot;Đăng nhập\&quot; as UC8\n  usecase \&quot;Thanh toán\&quot; as UC9\n  usecase \&quot;Đăng ký tài khoản\&quot; as UC10\n  usecase \&quot;Thêm sản phẩm vào giỏ\&quot; as UC11\n  usecase \&quot;Xem chi tiết sản phẩm\&quot; as UC12\n  usecase \&quot;Xem nhóm sản phẩm\&quot; as UC13\n  usecase \&quot;Kiểm tra thẻ\&quot; as UC14\n\n  UC1 -[hidden]down- UC2\n  UC2 -[hidden]down- UC3\n  UC3 -[hidden]down- UC4\n  UC4 -[hidden]down- UC5\n  UC5 -[hidden]down- UC6\n  UC6 -[hidden]down- UC7\n  UC7 -[hidden]down- UC8\n  UC8 -[hidden]down- UC9\n  UC9 -[hidden]down- UC10\n  UC10 -[hidden]down- UC11\n  UC11 -[hidden]down- UC12\n  UC12 -[hidden]down- UC13\n  UC13 -[hidden]down- UC14\n}\n\nKH --&gt; UC1\nKH --&gt; UC2\nKH --&gt; UC3\nKH --&gt; UC4\nKH --&gt; UC5\nKH --&gt; UC6\nKH --&gt; UC7\nKH --&gt; UC8\nKH --&gt; UC9\nKH --&gt; UC10\nKH --&gt; UC11\nKH --&gt; UC12\nKH --&gt; UC13\n\nQLSP --&gt; UC12\nQLSP --&gt; UC13\n\nDVTT --&gt; UC14\n\nUC7 ..&gt; UC4 : &lt;&lt;include&gt;&gt;\nUC7 ..&gt; UC6 : &lt;&lt;include&gt;&gt;\nUC7