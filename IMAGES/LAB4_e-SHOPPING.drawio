        <UserObject label="Activity Diagram - Quy trình đăng nhập" plantUmlId="title_0" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;whiteSpace=wrap;" plantUmlBaseValue="Activity Diagram - Quy trình đăng nhập" id="w1RjHFdL7Ps-hPTD1bQb-346">
          <mxCell parent="w1RjHFdL7Ps-hPTD1bQb-301" style="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1">
            <mxGeometry height="24" width="302" x="17.25" y="3410" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle Activity Diagram - Quy trình đăng nhập\n\nskinparam shadowing false\nskinparam backgroundColor White\nskinparam ArrowColor Black\nskinparam linetype ortho\n\nskinparam activity {\n    BackgroundColor White\n    BorderColor Gray\n    DiamondBackgroundColor White\n    DiamondBorderColor Gray\n    FontColor Black\n    StartColor Black\n    EndColor Black\n    RoundCorner 20\n}\n\nstart\n\n:Nhập tên đăng nhập;\n:Nhập mật khẩu;\n:Nhấn nút Đăng nhập;\n:Kiểm tra thông tin tài khoản;\n\nif (Tài khoản có tồn tại?) then (Có)\n\n    if (Mật khẩu chính xác?) then (Đúng)\n\n        :Xác thực đăng nhập;\n        :Mở màn hình sản phẩm;\n\n    else (Sai)\n\n        :Hiển thị \&quot;Sai mật khẩu\&quot;;\n        :Nhập lại mật khẩu;\n\n    endif\n\nelse (Không)\n\n    :Hiển thị \&quot;Tài khoản không tồn tại\&quot;;\n\n    if (Muốn đăng ký?) then (Có)\n\n        :Mở Form đăng ký;\n        :Nhập thông tin tài khoản;\n        :Tạo tài khoản mới;\n\n    else (Không)\n\n        :Kết thúc đăng nhập;\n\n    endif\n\nendif\n\nstop\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="w1RjHFdL7Ps-hPTD1bQb-347">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlId="start_0" plantUmlBaseStyle="ellipse;fillColor=#000000;strokeColor=#222222;shadow=0;" plantUmlBaseValue="" id="w1RjHFdL7Ps-hPTD1bQb-348">
