        <UserObject label="Sequence Diagram – Đăng nhập" plantUmlId="title_26" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;" plantUmlBaseValue="Sequence Diagram – Đăng nhập" id="w1RjHFdL7Ps-hPTD1bQb-73">
