        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle Sequence Diagram – Đăng nhập\n\nskinparam shadowing false\nskinparam backgroundColor White\nskinparam sequenceMessageAlign left\nskinparam responseMessageBelowArrow false\nskinparam ParticipantPadding 55\nskinparam sequence {\n    ArrowColor Black\n    ArrowThickness 1\n    LifeLineBorderColor Gray\n    ParticipantBackgroundColor #E6E6F2\n    ParticipantBorderColor Gray\n    ActorBorderColor Gray\n    ActorBackgroundColor #E6E6F2\n    GroupBorderColor Black\n    GroupBackgroundColor White\n    GroupHeaderFontColor Black\n    GroupFontColor Black\n}\n\nactor \&quot;Khách hàng\&quot; as KH\nboundary \&quot;FrmDangNhap\&quot; as FRM\ncontrol \&quot;KhachHangService\&quot; as SV\ndatabase \&quot;SQL Server\&quot; as SQL\n\nKH -&gt; FRM : Nhập tên đăng nhập,\\nmật khẩu\nKH -&gt; FRM : Nhấn Đăng nhập\n\nFRM -&gt; SV : DangNhap(username,password)\n\nSV -&gt; SQL : Kiểm tra tài khoản\nSQL --&gt; SV : Thông tin tài khoản\n\nalt Thông tin đúng\n    SV --&gt; FRM : Đăng nhập thành công\n    FRM --&gt; KH : Mở FrmSanPham\nelse Thông tin sai\n    SV --&gt; FRM : Đăng nhập thất bại\n    FRM --&gt; KH : Hiển thị thông báo lỗi\nend\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="w1RjHFdL7Ps-hPTD1bQb-46">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
