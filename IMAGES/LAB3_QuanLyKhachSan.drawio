        <UserObject label="BIỂU ĐỒ TUẦN TỰ - GHI NHẬN DỊCH VỤ" plantUmlId="title_29" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;" plantUmlBaseValue="BIỂU ĐỒ TUẦN TỰ - GHI NHẬN DỊCH VỤ" id="XJ-UKajQEVYRKRhjF5oD-133">
          <mxCell parent="XJ-UKajQEVYRKRhjF5oD-103" style="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1">
            <mxGeometry height="24" width="287.43980000000005" x="1129.4463142857144" y="850.44" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle BIỂU ĐỒ TUẦN TỰ - TRẢ PHÒNG VÀ THANH TOÁN\n\nskinparam shadowing false\nskinparam sequenceMessageAlign left\nskinparam responseMessageBelowArrow false\nskinparam ParticipantPadding 55\nskinparam sequence {\n    ArrowColor Black\n    ArrowThickness 1\n    LifeLineBorderColor Gray\n    ParticipantBackgroundColor #E6E6F2\n    ParticipantBorderColor Gray\n    ActorBorderColor Gray\n    ActorBackgroundColor #E6E6F2\n    GroupBorderColor Black\n    GroupBackgroundColor White\n    GroupHeaderFontColor Black\n    GroupFontColor Black\n}\n\nactor \&quot;Nhân viên\&quot; as NV\nboundary \&quot;FrmTraPhong\&quot; as FRM\ncontrol \&quot;TraPhongService\&quot; as SV\ndatabase \&quot;SQL Server\&quot; as SQL\n\nNV -&gt; FRM : Chọn phòng cần trả\n\nFRM -&gt; SV : LayThongTinTraPhong(maPhong)\n\nSV -&gt; SQL : Lấy tiền phòng\nSV -&gt; SQL : Lấy tiền dịch vụ\nSV -&gt; SQL : Lấy tiền đền bù\nSQL --&gt; SV : Dữ liệu chi phí\n\nSV -&gt; SV : Tính tổng tiền\n\nSV --&gt; FRM : Hiển thị tổng tiền\n\nNV -&gt; FRM : Nhấn Lập hóa đơn\nFRM -&gt; SV : LapHoaDon()\nSV -&gt; SQL : INSERT HoaDon\nSQL --&gt; SV : Mã hóa đơn\nSV --&gt; FRM : Hóa đơn được lập\n\nNV -&gt; FRM : Nhập số tiền thanh toán\nNV -&gt; FRM : Nhấn Thanh toán\n\nFRM -&gt; SV : ThanhToan(maHoaDon, soTien)\nSV -&gt; SQL : INSERT ThanhToan\nSV -&gt; SQL : UPDATE HoaDon\n\nalt Đã thanh toán đủ\n    SV -&gt; SQL : UPDATE trạng thái phòng = Trống\n    SV --&gt; FRM : Thanh toán hoàn tất\n    FRM --&gt; NV : Cho phép trả phòng\nelse Chưa thanh toán đủ\n    SV --&gt; FRM : Còn thiếu tiền\n    FRM --&gt; NV : Hiển thị số tiền còn thiếu\nend\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="XJ-UKajQEVYRKRhjF5oD-134">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
