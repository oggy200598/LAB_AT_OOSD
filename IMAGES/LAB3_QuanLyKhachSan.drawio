        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle BIỂU ĐỒ TUẦN TỰ - ĐẶT PHÒNG\n\nskinparam shadowing false\nskinparam sequenceMessageAlign left\nskinparam responseMessageBelowArrow false\nskinparam ParticipantPadding 55\nskinparam sequence {\n    ArrowColor Black\n    ArrowThickness 1\n    LifeLineBorderColor Gray\n    ParticipantBackgroundColor #E6E6F2\n    ParticipantBorderColor Gray\n    ActorBorderColor Gray\n    ActorBackgroundColor #E6E6F2\n    GroupBorderColor Black\n    GroupBackgroundColor White\n    GroupHeaderFontColor Black\n    GroupFontColor Black\n}\n\nactor \&quot;Nhân viên\&quot; as NV\nboundary \&quot;FrmDatPhong\&quot; as FRM\ncontrol \&quot;DatPhongService\&quot; as SV\ndatabase \&quot;SQL Server\&quot; as SQL\n\nNV -&gt; FRM : Nhập thông tin khách hàng\nNV -&gt; FRM : Chọn phòng và thời gian thuê\n\nFRM -&gt; SV : KiemTraPhong(maPhong, tuNgay, denNgay)\nSV -&gt; SQL : Kiểm tra lịch đặt phòng\nSQL --&gt; SV : Kết quả kiểm tra\n\nalt Phòng còn trống\n    SV --&gt; FRM : Phòng hợp lệ\n    NV -&gt; FRM : Nhấn Đặt phòng\n    FRM -&gt; SV : DatPhong(thongTin)\n    SV -&gt; SQL : INSERT DatPhong\n    SQL --&gt; SV : Thành công\n    SV --&gt; FRM : Đặt phòng thành công\n    FRM --&gt; NV : Hiển thị kết quả\nelse Phòng đã được đặt\n    SV --&gt; FRM : Phòng đã có lịch\n    FRM --&gt; NV : Thông báo không thể đặt\nend\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="XJ-UKajQEVYRKRhjF5oD-1">
