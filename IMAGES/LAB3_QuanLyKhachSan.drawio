        <UserObject label="BIỂU ĐỒ TUẦN TỰ - ĐẶT PHÒNG" plantUmlId="title_31" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;" plantUmlBaseValue="BIỂU ĐỒ TUẦN TỰ - ĐẶT PHÒNG" id="XJ-UKajQEVYRKRhjF5oD-33">
          <mxCell parent="XJ-UKajQEVYRKRhjF5oD-1" style="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1">
            <mxGeometry height="24" width="228.34990000000008" x="334.4191678571429" y="90" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle BIỂU ĐỒ TUẦN TỰ - NHẬN PHÒNG\n\nskinparam shadowing false\nskinparam sequenceMessageAlign left\nskinparam responseMessageBelowArrow false\nskinparam ParticipantPadding 55\nskinparam sequence {\n    ArrowColor Black\n    ArrowThickness 1\n    LifeLineBorderColor Gray\n    ParticipantBackgroundColor #E6E6F2\n    ParticipantBorderColor Gray\n    ActorBorderColor Gray\n    ActorBackgroundColor #E6E6F2\n    GroupBorderColor Black\n    GroupBackgroundColor White\n    GroupHeaderFontColor Black\n    GroupFontColor Black\n}\n\nactor \&quot;Nhân viên\&quot; as NV\nboundary \&quot;FrmDatPhong\&quot; as FRM\ncontrol \&quot;DatPhongService\&quot; as SV\ndatabase \&quot;SQL Server\&quot; as SQL\n\nNV -&gt; FRM : Chọn phiếu đặt phòng\nFRM -&gt; SV : KiemTraDatPhong(maDatPhong)\nSV -&gt; SQL : SELECT thông tin đặt phòng\nSQL --&gt; SV : Thông tin đặt phòng\n\nalt Đặt phòng hợp lệ\n    SV --&gt; FRM : Cho phép nhận phòng\n    NV -&gt; FRM : Nhấn Nhận phòng\n    FRM -&gt; SV : NhanPhong(maDatPhong)\n    SV -&gt; SQL : UPDATE trạng thái phòng\n    SV -&gt; SQL : UPDATE trạng thái đặt phòng\n    SQL --&gt; SV : Thành công\n    SV --&gt; FRM : Nhận phòng thành công\n    FRM --&gt; NV : Hiển thị thông báo\nelse Không hợp lệ\n    SV --&gt; FRM : Không thể nhận phòng\n    FRM --&gt; NV : Hiển thị lỗi\nend\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="XJ-UKajQEVYRKRhjF5oD-34">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
