        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle BIỂU ĐỒ TUẦN TỰ - LẬP PHIẾU LẮP ĐẶT\n\nskinparam shadowing false\nskinparam sequenceMessageAlign left\nskinparam responseMessageBelowArrow false\nskinparam ParticipantPadding 55\nskinparam sequence {\n    ArrowColor Black\n    ArrowThickness 1\n    LifeLineBorderColor Gray\n    ParticipantBackgroundColor #E6E6F2\n    ParticipantBorderColor Gray\n    ActorBorderColor Gray\n    ActorBackgroundColor #E6E6F2\n    GroupBorderColor Black\n    GroupBackgroundColor White\n    GroupHeaderFontColor Black\n    GroupFontColor Black\n}\n\nactor \&quot;Nhân viên\&quot; as NV\nboundary \&quot;FrmPhongTienNghi\&quot; as FRM\ncontrol \&quot;PhongTienNghiService\&quot; as SV\ndatabase \&quot;SQL Server\&quot; as SQL\n\nNV -&gt; FRM : Chọn phòng\nFRM -&gt; SV : LayDanhSachTienNghi()\nSV -&gt; SQL : SELECT tiện nghi\nSQL --&gt; SV : Danh sách tiện nghi\nSV --&gt; FRM : Hiển thị danh sách\n\nNV -&gt; FRM : Chọn tiện nghi\nNV -&gt; FRM : Nhập số lượng\nNV -&gt; FRM : Nhấn Lưu\n\nFRM -&gt; SV : LapPhieuLapDat(thongTin)\nSV -&gt; SQL : Kiểm tra tiện nghi\nSQL --&gt; SV : Kết quả kiểm tra\n\nalt Dữ liệu hợp lệ\n    SV -&gt; SQL : INSERT LapDat\n    SQL --&gt; SV : Thành công\n    SV --&gt; FRM : Lập phiếu thành công\n    FRM --&gt; NV : Hiển thị kết quả\nelse Dữ liệu không hợp lệ\n    SV --&gt; FRM : Thông báo lỗi\n    FRM --&gt; NV : Hiển thị lỗi\nend\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="XJ-UKajQEVYRKRhjF5oD-67">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
