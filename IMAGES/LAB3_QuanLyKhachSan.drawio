        <UserObject label="BIỂU ĐỒ TUẦN TỰ - NHẬN PHÒNG" plantUmlId="title_31" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;" plantUmlBaseValue="BIỂU ĐỒ TUẦN TỰ - NHẬN PHÒNG" id="XJ-UKajQEVYRKRhjF5oD-66">
