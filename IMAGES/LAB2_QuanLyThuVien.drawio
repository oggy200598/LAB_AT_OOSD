        <mxCell id="RJzYo9YLguezItQR9zq6-266" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;p class=&quot;MsoListParagraph&quot; style=&quot;margin-left:72.0pt;mso-add-space:auto;&amp;lt;br/&amp;gt;text-indent:-36.0pt;mso-list:l0 level2 lfo1&quot;&gt;&lt;b&gt;&lt;span lang=&quot;VI&quot;&gt;&lt;span style=&quot;font:7.0pt &amp;quot;Times New Roman&amp;quot;&quot;&gt;&amp;nbsp; &amp;nbsp;&lt;br&gt;&lt;/span&gt;&lt;/span&gt;&lt;/b&gt;&lt;b&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;Sequence Diagram nghiệp vụ cấp/gia hạn thẻ&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;p class=&quot;MsoListParagraph&quot; style=&quot;margin-left:72.0pt;mso-add-space:auto;&amp;lt;br/&amp;gt;text-indent:-36.0pt;mso-list:l0 level2 lfo1&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="30" width="520" x="1241" y="2680" as="geometry" />
        </mxCell>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\nhide footbox\nskinparam shadowing false\nskinparam sequenceMessageAlign center\nskinparam responseMessageBelowArrow false\nskinparam ParticipantPadding 55\nskinparam sequence {\n    ParticipantBackgroundColor White\n    ParticipantBorderColor Black\n    ParticipantFontColor Black\n    ParticipantFontSize 14\n    LifeLineBorderColor Black\n    LifeLineBackgroundColor White\n    ArrowColor Black\n    ArrowThickness 1\n    ActivationBackgroundColor White\n    ActivationBorderColor Black\n}\n\nparticipant \&quot;Độc giả\&quot; as DG\nparticipant \&quot;Thủ thư\&quot; as TT\nparticipant \&quot;FrmDocgia\&quot; as FRM\nparticipant \&quot;DocGiaService\&quot; as SV\nparticipant \&quot;SQL Server\&quot; as SQL\n\nDG -&gt; TT : 1.Yêu cầu cấp/gia hạn\nactivate DG\nactivate TT\n\nTT -&gt; FRM : 2.Nhập thông tin thẻ\\n(ngày cấp,hạn,lệ phí...)\nactivate FRM\ndeactivate TT\ndeactivate DG\n\nFRM -&gt; SV : 3.Kiểm tra thẻ hiện có\nactivate SV\n\nFRM -&gt; SV : 4.Tạo thẻ\\n(mã thẻ,ngày cấp,hạn,lệ phí)\n\nSV -&gt; SQL : 5.INSERT THEDOCGIA\nactivate SQL\n\nSQL --&gt; SV : 6.Kết quả\ndeactivate SQL\n\nSV -&gt; FRM : 7.Thông báo cấp thẻ thành công\ndeactivate SV\n\nFRM -&gt; SV : 8.Cập nhật hạn sử dụng\\n(mathe, hạn mới)\nactivate SV\n\nSV -&gt; SQL : 9.UPDATE THEDOCGIA\nactivate SQL\n\nSQL --&gt; SV : 10.Kết quả\ndeactivate SQL\n\nSV --&gt; FRM : 11.Thông báo gia hạn thành công\ndeactivate SV\n\nFRM -&gt; TT : 12.Thông báo kết quả\nTT -&gt; DG\ndeactivate FRM\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="RJzYo9YLguezItQR9zq6-313">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
