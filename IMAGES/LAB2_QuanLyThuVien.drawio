        <mxCell id="RJzYo9YLguezItQR9zq6-339" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;p class=&quot;MsoListParagraph&quot; style=&quot;margin-left:72.0pt;mso-add-space:auto;&amp;lt;br/&amp;gt;text-indent:-36.0pt;mso-list:l0 level2 lfo1&quot;&gt;&lt;b&gt;&lt;span lang=&quot;VI&quot;&gt;&lt;span style=&quot;font:7.0pt &amp;quot;Times New Roman&amp;quot;&quot;&gt;&amp;nbsp; &amp;nbsp;&lt;br&gt;&lt;/span&gt;&lt;/span&gt;&lt;/b&gt;&lt;b&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;Sequence Diagram nghiệp vụ Mượn sách&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;p class=&quot;MsoListParagraph&quot; style=&quot;margin-left:72.0pt;mso-add-space:auto;&amp;lt;br/&amp;gt;text-indent:-36.0pt;mso-list:l0 level2 lfo1&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="30" width="520" x="170" y="3300" as="geometry" />
        </mxCell>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\nhide footbox\nskinparam shadowing false\nskinparam sequenceMessageAlign center\nskinparam responseMessageBelowArrow false\nskinparam ParticipantPadding 55\nskinparam sequence {\n    ParticipantBackgroundColor White\n    ParticipantBorderColor Black\n    ParticipantFontColor Black\n    ParticipantFontSize 14\n    LifeLineBorderColor Black\n    LifeLineBackgroundColor White\n    ArrowColor Black\n    ArrowThickness 1\n    ActivationBackgroundColor White\n    ActivationBorderColor Black\n}\n\nparticipant \&quot;Độc giả\&quot; as DG\nparticipant \&quot;Thủ thư\&quot; as TT\nparticipant \&quot;FrmDocgia\&quot; as FRM\nparticipant \&quot;DocGiaService\&quot; as SV\nparticipant \&quot;SQL Server\&quot; as SQL\n\nDG -&gt; TT : 1.Xuất trình thẻ,\\nyêu cầu mượn sách\nactivate DG\nactivate TT\n\nTT -&gt; FRM : 2.Nhập mã độc giả chọn sách\nactivate FRM\n\nFRM -&gt; SV : 3.Kiểm tra thẻ và\\nđiều kiện mượn\nactivate SV\n\nSV -&gt; SQL : 4.Kiểm tra thẻ, số sách\\nđang mượn\nactivate SQL\n\nSV -&gt; SQL : 5.Kiểm tra tồn kho từng sách\n\nSQL --&gt; SV : 6.Kết quả kiểm tra\ndeactivate SQL\n\nSV --&gt; TT : 7.Thông báo lỗi (lý do)\ndeactivate SV\n\ndeactivate FRM\n\n||10||\n\nactivate FRM\nFRM -&gt; SQL : 8.Lập phiếu mượn\nactivate SQL\n\nFRM -&gt; SQL : 9.Lưu chi tiết phiếu mượn\n\nFRM -&gt; SQL : 10.Cập nhật số lượng sách\n\nSQL --&gt; FRM : 11.Kết quả\ndeactivate SQL\n\ndeactivate FRM\n\nFRM -&gt; TT : 12.Thông báo mượn thành công\n\nTT -&gt; DG : 13.Nhận sách và phiếu mượn\ndeactivate TT\ndeactivate DG\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="RJzYo9YLguezItQR9zq6-340">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Độc giả" plantUmlId="p_7" plantUmlBaseStyle="shape=umlLifeline;perimeter=lifelinePerimeter;size=30.49;lifelineMirror=1;dashPattern=5 5;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;sequenceEdgeStyle&quot;,&quot;libavoidRouting&quot;:0,&quot;curved&quot;:0,&quot;rounded&quot;:0};rounded=1;absoluteArcSize=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=0.5;fontColor=#000000;fontSize=14;whiteSpace=wrap;html=1;shadow=0;" plantUmlBaseValue="Độc giả" id="RJzYo9YLguezItQR9zq6-341">
