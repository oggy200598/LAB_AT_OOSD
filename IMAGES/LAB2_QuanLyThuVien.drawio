        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\nhide footbox\nskinparam shadowing false\nskinparam sequenceMessageAlign center\nskinparam responseMessageBelowArrow false\nskinparam ParticipantPadding 35\nskinparam BoxPadding 10\nskinparam sequence {\n    ParticipantBackgroundColor white\n    ParticipantBorderColor black\n    ParticipantFontColor black\n    LifeLineBorderColor black\n    LifeLineBackgroundColor white\n    ArrowColor black\n    ActivationBackgroundColor white\n    ActivationBorderColor black\n}\n\nparticipant \&quot;Độc giả\&quot; as DG\nparticipant \&quot;Thủ thư\&quot; as TT\nparticipant \&quot;FrmDocgia\&quot; as FRM\nparticipant \&quot;DocGiaService\&quot; as SV\nparticipant \&quot;SQL Server\&quot; as SQL\n\nDG -&gt; TT : 1.Cung cấp thông tin độc giả\nactivate DG\nactivate TT\n\nTT -&gt; FRM : 2.Nhập thông tin\\n(thêm/cập nhật)\nactivate FRM\n\nFRM -&gt; SV : 3.Kiểm tra dữ liệu\nactivate SV\n\nSV -&gt; SQL : 4.Thực thi SQL\\n(INSERT/UPDATE DOCGIA)\nactivate SQL\n\nSQL --&gt; SV : 5.Kết quả\ndeactivate SQL\n\nSV --&gt; FRM : 6.Thông báo kết quả\ndeactivate SV\n\nFRM -&gt; TT : 7.Hiển thị danh sách độc giả\ndeactivate FRM\ndeactivate TT\ndeactivate DG\n\n||30||\nactivate DG\nTT --&gt; DG : 8.Thông báo lỗi\ndeactivate DG\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="RJzYo9YLguezItQR9zq6-246">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
