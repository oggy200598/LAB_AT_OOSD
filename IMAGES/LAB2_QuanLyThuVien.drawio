        </mxCell>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\nhide footbox\nskinparam shadowing false\nskinparam sequenceMessageAlign center\nskinparam responseMessageBelowArrow false\nskinparam ParticipantPadding 55\nskinparam sequence {\n    ParticipantBackgroundColor White\n    ParticipantBorderColor Black\n    ParticipantFontColor Black\n    ParticipantFontSize 14\n    LifeLineBorderColor Black\n    LifeLineBackgroundColor White\n    ArrowColor Black\n    ArrowThickness 1\n    ActivationBackgroundColor White\n    ActivationBorderColor Black\n}\n\nparticipant \&quot;Độc giả\&quot; as DG\nparticipant \&quot;Thủ thư\&quot; as TT\nparticipant \&quot;FrmDocgia\&quot; as FRM\nparticipant \&quot;DocGiaService\&quot; as SV\nparticipant \&quot;SQL Server\&quot; as SQL\n\nDG -&gt; TT : 1.Mang sách đến trả\nactivate DG\nactivate TT\n\nTT -&gt; FRM : 2.Chọn phiếu mượn,\\nnhập tình trạng sách\nactivate FRM\n\nFRM -&gt; SV : 3.Kiểm tra thông tin mượn\nactivate SV\n\nSV -&gt; SQL : 4.Lấy thông tin chi tiết\nactivate SQL\n\nSQL -&gt; SV : 5.Trả về thông tin\ndeactivate SQL\n\nSV -&gt; SQL : 6.Kiểm tra quá hạn/hư hỏng/\\nmất\nactivate SQL\n\nSQL --&gt; SV : 7.Kết quả kiểm tra\ndeactivate SQL\n\nSV -&gt; SQL : 8.Tính phí phạt\nactivate SQL\n\nSV -&gt; SQL : 9.Lập phiếu phạt\n\nSV -&gt; SQL : 10.Lưu phiếu phạt\n\nSQL --&gt; SV : 11.Kết quả\ndeactivate SQL\n\nSV --&gt; FRM : 12.Thông báo lập phiếu phạt\ndeactivate SV\n\nSV -&gt; SQL : 13.Cập nhật tình trạng trả sách\nactivate SQL\nactivate SV\n\nSV -&gt; SQL : 14.Cập nhật số lượng sách\n\nSQL --&gt; SV : 11.Kết quả\ndeactivate SQL\n\nSV --&gt; FRM : 16.Thông báo trả sách thành công\ndeactivate SV\n\nFRM -&gt; TT\ndeactivate FRM\n\nTT -&gt; DG : 17.Nhận lại phiếu trả\ndeactivate TT\ndeactivate DG\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="RJzYo9YLguezItQR9zq6-367">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
