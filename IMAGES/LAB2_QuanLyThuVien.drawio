        <mxCell id="RJzYo9YLguezItQR9zq6-366" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;p class=&quot;MsoListParagraph&quot; style=&quot;margin-left:72.0pt;mso-add-space:auto;&amp;lt;br/&amp;gt;text-indent:-36.0pt;mso-list:l0 level2 lfo1&quot;&gt;&lt;b&gt;&lt;span lang=&quot;VI&quot;&gt;&lt;span style=&quot;font:7.0pt &amp;quot;Times New Roman&amp;quot;&quot;&gt;&amp;nbsp; &amp;nbsp;&lt;br&gt;&lt;/span&gt;&lt;/span&gt;&lt;/b&gt;&lt;b&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;Sequence Diagram nghiệp vụ trả sách và lập phiếu phạt&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;p class=&quot;MsoListParagraph&quot; style=&quot;margin-left:72.0pt;mso-add-space:auto;&amp;lt;br/&amp;gt;text-indent:-36.0pt;mso-list:l0 level2 lfo1&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;" vertex="1">
