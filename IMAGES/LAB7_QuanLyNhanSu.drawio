        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle Quy trình từ thử việc đến ký hợp đồng\n\nleft to right direction\nskinparam shadowing false\nskinparam backgroundColor White\nskinparam linetype ortho\nskinparam actorStyle stickman\nskinparam nodesep 50\nskinparam ranksep 65\n\nskinparam usecase {\n    BackgroundColor White\n    BorderColor Black\n    ArrowColor Black\n    FontColor Black\n}\n\nskinparam rectangle {\n    BackgroundColor White\n    BorderColor Black\n}\n\nactor \&quot;NV nhân sự\&quot; as NS\nactor \&quot;Giám đốc\&quot; as GD\nactor \&quot;Trưởng phòng\&quot; as TP\n\nrectangle \&quot;Quy trình từ thử việc đến ký hợp đồng\&quot; {\n\n    usecase \&quot;Phân công phòng ban thử việc\&quot; as UC1\n    usecase \&quot;Tiếp nhận nhân viên\&quot; as UC2\n    usecase \&quot;Xác định thời gian\\nvà lương thử việc\&quot; as UC3\n\n    usecase \&quot;Lập quyết định tuyển dụng\&quot; as UC4\n    usecase \&quot;Lập hợp đồng lao động\&quot; as UC5\n\n    usecase \&quot;Theo dõi quá trình thử việc\&quot; as UC6\n    usecase \&quot;Xét duyệt nhân viên chính thức\&quot; as UC7\n    usecase \&quot;Đánh giá kết quả thử việc\&quot; as UC8\n    usecase \&quot;Ký hợp đồng chính thức\&quot; as UC9\n\n    UC1 -[hidden]right- UC2\n    UC2 -[hidden]right- UC3\n\n    UC4 -[hidden]right- UC5\n\n    UC6 -[hidden]right- UC7\n    UC7 -[hidden]right- UC8\n\n    UC1 -[hidden]down- UC4\n    UC4 -[hidden]down- UC6\n    UC6 -[hidden]down- UC9\n}\n\nNS --&gt; UC1\nNS --&gt; UC2\nNS --&gt; UC3\nNS --&gt; UC4\nNS --&gt; UC5\n\nGD --&gt; UC4\nGD --&gt; UC6\nGD --&gt; UC9\n\nTP --&gt; UC6\nTP --&gt; UC8\n\nUC4 ..&gt; UC2 : &lt;&lt;include&gt;&gt;\nUC4 ..&gt; UC3 : &lt;&lt;include&gt;&gt;\nUC7 ..&gt; UC8 : &lt;&lt;include&gt;&gt;\nUC9 ..&gt; UC5 : &lt;&lt;include&gt;&gt;\nUC7 ..&gt; UC6 : &lt;&lt;extend&gt;&gt;\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="dBRbkEZpuAqh5RYjev3S-1802">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
