        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle CLASS DIAGRAM - QUẢN LÝ NHÂN SỰ\n\ntop to bottom direction\nskinparam linetype ortho\nskinparam classAttributeIconSize 0\nskinparam shadowing false\nskinparam backgroundColor White\nskinparam nodesep 50\nskinparam ranksep 65\n\nhide circle\n\nclass PhongBan {\nMaPB: int\nTenPB: string\nDiaDiem: string\nDienThoai: string\nMaTruongPhong: int\n--\nthemPhongBan()\nsuaPhongBan()\nxoaPhongBan()\nlayDanhSachNhanVien()\n}\n\nclass NhanVien {\nMaNV: int\nHoTen: string\nNgaySinh: DateTime\nGioiTinh: string\nDiaChi: string\nDienThoai: string\nCCCD: string\nNgayVaoLam: DateTime\nTrangThai: string\nMaPB: int\n--\nthemNhanVien()\nsuaNhanVien()\nxoaNhanVien()\ntimNhanVien()\n}\n\nclass ChucVu {\nMaCV: int\nTenCV: string\nMoTa: string\nPhuCapMacDinh: decimal\n--\nthemChucVu()\nsuaChucVu()\nxoaChucVu()\n}\n\nclass QuyetDinhTuyenDung {\nMaQDTD: int\nMaNV: int\nMaPB: int\nNgayQuyetDinh: DateTime\nNgayBatDauThuViec: DateTime\nNgayKetThucThuViec: DateTime\nLuongThuViec: decimal\nNoiDung: string\nNguoiKy: string\n--\nlapQuyetDinh()\ncapNhatQuyetDinh()\nkiemTraThuViec()\n}\n\nclass HopDongLaoDong {\nMaHD: int\nMaNV: int\nLoaiHopDong: string\nNgayKy: DateTime\nNgayBatDau: DateTime\nNgayKetThuc: DateTime\nNoiDung: string\nTrangThai: string\n--\nlapHopDong()\ngiaHanHopDong()\nchamDutHopDong()\nkiemTraHieuLuc()\n}\n\nclass BaoHiem {\nMaBH: int\nMaNV: int\nSoBHXH: string\nSoBHYT: string\nNgayThamGia: DateTime\nMucDongBHXH: decimal\nMucDongBHYT: decimal\nTrangThai: string\n--\ndangKyBaoHiem()\ncapNhatBaoHiem()\ntinhTienBaoHiem()\n}\n\nclass QuyetDinhLuong {\nMaQDL: int\nMaNV: int\nNgayQuyetDinh: DateTime\nNgayHieuLuc: DateTime\nLuongCoBan: decimal\nPhuCapLuong: decimal\nPhuCapDocHai: decimal\nLyDo: string\nNguoiKy: string\n--\nlapQuyetDinhLuong()\ndieuChinhLuong()\nlayLuongHienTai()\n}\n\nclass QuyetDinhChucVu {\nMaQDCV: int\nMaNV: int\nMaCV: int\nNgayQuyetDinh: DateTime\nNgayHieuLuc: DateTime\nPhuCapChucVu: decimal\nNoiDung: string\nNguoiKy: string\n--\nlapQuyetDinhChucVu()\nboNhiemChucVu()\ndieuChinhPhuCap()\n}\n\nclass CaLamViec {\nMaCa: int\nTenCa: string\nGioBatDau: TimeSpan\nGioKetThuc: TimeSpan\n--\nthemCaLam()\nsuaCaLam()\ntinhSoGioLam()\n}\n\nclass KeHoachPhanCong {\nMaKH: int\nMaPB: int\nTuan: int\nNam: int\nNgayLap: DateTime\nMaNguoiLap: int\nTrangThai: string\n--\nlapKeHoach()\ncapNhatKeHoach()\nduyetKeHoach()\n}\n\nclass ChiTietPhanCong {\nMaCTPC: int\nMaKH: int\nMaNV: int\nMaCa: int\nNgayLamViec: DateTime\nCoPhuTroiDuKien: bool\n--\nphanCongNhanVien()\nthayDoiCaLam()\nhuyPhanCong()\n}\n\nclass BangChamCong {\nMaBCC: int\nThang: int\nNam: int\nNgayLap: DateTime\nNguoiLap: string\nTrangThai: string\n--\nlapBangChamCong()\ncapNhatChamCong()\ntongHopNgayCong()\n}\n\nclass ChiTietChamCong {\nMaCTCC: int\nMaBCC: int\nMaNV: int\nNgayChamCong: DateTime\nMaCa: int\nSoGioLam: decimal\nTrangThai: string\n--\nghiNhanChamCong()\ncapNhatGioLam()\ntinhNgayCong()\n}\n\nclass PhieuPhuTroi {\nMaPhieuPT: int\nNgayPhuTroi: DateTime\nSoGioPhuTroi: decimal\nHinhThucPhuTroi: string\nHeSoPhuTroi: decimal\nNguoiLap: string\n--\nlapPhieuPhuTroi()\ncapNhatPhieu()\ntinhTienPhuTroi()\n}\n\nclass ChiTietPhuTroi {\nMaCTPT: int\nMaPhieuPT: int\nMaNV: int\nSoGioThucTe: decimal\nGhiChu: string\n--\nthemNhanVienPhuTroi()\ncapNhatGioPhuTroi()\ntinhTienPhuTroiNhanVien()\n}\n\nclass QuyetDinhKhenThuong {\nMaQDKT: int\nNgayQuyetDinh: DateTime\nDoiTuong: string\nMaNV: int\nMaPB: int\nLyDo: string\nSoTienThuong: decimal\nNguoiKy: string\n--\nlapQuyetDinhKhenThuong()\ncapNhatKhenThuong()\nduyetKhenThuong()\n}\n\nclass PhieuChiKhenThuong {\nMaPhieuChi: int\nMaQDKT: int\nNgayChi: DateTime\nSoTienChi: decimal\nHinhThucChi: string\nNguoiLap: string\nTrangThai: string\n--\nlapPhieuChi()\nthucHienChiThuong()\nxacNhanChiThuong()\n}\n\nclass QuyetDinhKyLuat {\nMaQDKL: int\nNgayQuyetDinh: DateTime\nDoiTuong: string\nMaNV: int\nMaPB: int\nLyDo: string\nHinhThucKyLuat: string\nSoTienPhat: decimal\nNguoiKy: string\n--\nlapQuyetDinhKyLuat()\ncapNhatKyLuat()\ntinhTienPhat()\n}\n\nclass PhieuThuNopPhat {\nMaPhieuThu: int\nMaQDKL: int\nNgayThu: DateTime\nSoTienThu: decimal\nHinhThucThu: string\nTrangThai: string\n--\nlapPhieuThu()\nthuTienPhat()\nxacNhanNopPhat()\n}\n\nclass BangLuong {\nMaBL: int\nThang: int\nNam: int\nNgayLap: DateTime\nTongLuong: decimal\nTrangThai: string\n--\nlapBangLuong()\ntinhTongLuong()\nduyetBangLuong()\nxuatBangLuong()\n}\n\nclass ChiTietBangLuong {\nMaCTBL: int\nMaBL: int\nMaNV: int\nLuongCoBan: decimal\nLuongTheoCong: decimal\nPhuCap: decimal\nTienPhuTroi: decimal\nTienThuong: decimal\nTienPhat: decimal\nTienBaoHiem: decimal\nThucLanh: decimal\n--\ntinhLuongTheoCong()\ntinhTienPhuTroi()\ntinhTongThuNhap()\ntinhKhauTru()\ntinhLuongThucLanh()\n}\n\nPhongBan \&quot;1\&quot; -- \&quot;0..*\&quot; NhanVien\nPhongBan \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhTuyenDung\nPhongBan \&quot;1\&quot; -- \&quot;0..*\&quot; KeHoachPhanCong\n\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhTuyenDung\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; HopDongLaoDong\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; BaoHiem\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhLuong\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhChucVu\n\nChucVu \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhChucVu\n\nKeHoachPhanCong \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietPhanCong\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietPhanCong\nCaLamViec \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietPhanCong\n\nBangChamCong \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietChamCong\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietChamCong\nCaLamViec \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietChamCong\n\nPhieuPhuTroi \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietPhuTroi\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietPhuTroi\n\nNhanVien \&quot;0..1\&quot; -- \&quot;0..*\&quot; QuyetDinhKhenThuong\nPhongBan \&quot;0..1\&quot; -- \&quot;0..*\&quot; QuyetDinhKhenThuong\n\nNhanVien \&quot;0..1\&quot; -- \&quot;0..*\&quot; QuyetDinhKyLuat\nPhongBan \&quot;0..1\&quot; -- \&quot;0..*\&quot; QuyetDinhKyLuat\n\nQuyetDinhKhenThuong \&quot;1\&quot; -- \&quot;0..1\&quot; PhieuChiKhenThuong\nQuyetDinhKyLuat \&quot;1\&quot; -- \&quot;0..1\&quot; PhieuThuNopPhat\n\nBangLuong \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietBangLuong\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietBangLuong\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="dBRbkEZpuAqh5RYjev3S-988">
