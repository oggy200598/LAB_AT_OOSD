        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle Khen thuong - Ky luat - Tinh luong\n\ntop to bottom direction\nskinparam linetype ortho\nskinparam shadowing false\nskinparam backgroundColor White\nskinparam classAttributeIconSize 0\nskinparam nodesep 55\nskinparam ranksep 75\n\nhide circle\n\nskinparam class {\n    BackgroundColor White\n    HeaderBackgroundColor #EDEDED\n    BorderColor Black\n    ArrowColor Black\n    FontColor Black\n}\n\nclass NhanVien {\n    MaNV: int «PK»\n    HoTen: string\n    --\n    timNhanVien()\n}\n\nclass PhongBan {\n    MaPB: int «PK»\n    TenPB: string\n    --\n    layDanhSachNhanVien()\n}\n\nclass QuyetDinhKhenThuong {\n    MaQDKT: int «PK»\n    NgayQuyetDinh: DateTime\n    DoiTuong: string\n    MaNV: int «FK»\n    MaPB: int «FK»\n    LyDo: string\n    SoTienThuong: decimal\n    NguoiKy: string\n    --\n    lapQuyetDinhKhenThuong()\n    capNhatKhenThuong()\n    duyetKhenThuong()\n}\n\nclass QuyetDinhKyLuat {\n    MaQDKL: int «PK»\n    NgayQuyetDinh: DateTime\n    DoiTuong: string\n    MaNV: int «FK»\n    MaPB: int «FK»\n    LyDo: string\n    HinhThucKyLuat: string\n    SoTienPhat: decimal\n    NguoiKy: string\n    --\n    lapQuyetDinhKyLuat()\n    capNhatKyLuat()\n    tinhTienPhat()\n}\n\nclass BangLuong {\n    MaBL: int «PK»\n    Thang: int\n    Nam: int\n    NgayLap: DateTime\n    TongLuong: decimal\n    TrangThai: string\n    --\n    lapBangLuong()\n    tinhTongLuong()\n    duyetBangLuong()\n    xuatBangLuong()\n}\n\nclass PhieuChiKhenThuong {\n    MaPhieuChi: int «PK»\n    MaQDKT: int «FK»\n    NgayChi: DateTime\n    SoTienChi: decimal\n    HinhThucChi: string\n    NguoiLap: string\n    TrangThai: string\n    --\n    lapPhieuChi()\n    thucHienChiThuong()\n    xacNhanChiThuong()\n}\n\nclass PhieuThuNopPhat {\n    MaPhieuThu: int «PK»\n    MaQDKL: int «FK»\n    NgayThu: DateTime\n    SoTienThu: decimal\n    HinhThucThu: string\n    TrangThai: string\n    --\n    lapPhieuThu()\n    thuTienPhat()\n    xacNhanNopPhat()\n}\n\nclass ChiTietBangLuong {\n    MaCTBL: int «PK»\n    MaBL: int «FK»\n    MaNV: int «FK»\n    LuongCoBan: decimal\n    LuongTheoCong: decimal\n    PhuCap: decimal\n    TienPhuTroi: decimal\n    TienThuong: decimal\n    TienPhat: decimal\n    TienBaoHiem: decimal\n    ThucLanh: decimal\n    --\n    tinhLuongTheoCong()\n    tinhTienPhuTroi()\n    tinhTongThuNhap()\n    tinhKhauTru()\n    tinhLuongThucLanh()\n}\n\nNhanVien \&quot;0..1\&quot; -- \&quot;0..*\&quot; QuyetDinhKhenThuong\nNhanVien \&quot;0..1\&quot; -- \&quot;0..*\&quot; QuyetDinhKyLuat\nPhongBan \&quot;0..1\&quot; -- \&quot;0..*\&quot; QuyetDinhKhenThuong\nPhongBan \&quot;0..1\&quot; -- \&quot;0..*\&quot; QuyetDinhKyLuat\n\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietBangLuong\n\nQuyetDinhKhenThuong \&quot;1\&quot; -- \&quot;0..1\&quot; PhieuChiKhenThuong\nQuyetDinhKyLuat \&quot;1\&quot; -- \&quot;0..1\&quot; PhieuThuNopPhat\n\nBangLuong \&quot;1\&quot; *-- \&quot;0..*\&quot; ChiTietBangLuong\n\nNhanVien -[hidden]right- PhongBan\nQuyetDinhKhenThuong -[hidden]right- QuyetDinhKyLuat\nQuyetDinhKyLuat -[hidden]right- BangLuong\nPhieuChiKhenThuong -[hidden]right- PhieuThuNopPhat\nPhieuThuNopPhat -[hidden]right- ChiTietBangLuong\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="dBRbkEZpuAqh5RYjev3S-1650">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
