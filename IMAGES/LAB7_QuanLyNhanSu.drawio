        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle USE CASE TONG QUAT - QUAN LY NHAN SU SON DONG A\n\nleft to right direction\n\nskinparam shadowing false\nskinparam backgroundColor White\nskinparam linetype ortho\nskinparam actorStyle stickman\nskinparam nodesep 45\nskinparam ranksep 65\n\nskinparam usecase {\n    BackgroundColor White\n    BorderColor Black\n    ArrowColor Black\n    FontColor Black\n}\n\nskinparam rectangle {\n    BackgroundColor White\n    BorderColor Black\n}\n\nactor \&quot;NV nhân sự\&quot; as NS\nactor \&quot;Ban chấm công\&quot; as BCC\nactor \&quot;Kế toán\&quot; as KT\nactor \&quot;Trưởng phòng\&quot; as TP\nactor \&quot;Giám đốc\&quot; as GD\n\nrectangle \&quot; \&quot; {\n    usecase \&quot;Quản lý nhân viên\\nvà phòng ban\&quot; as UC1\n    usecase \&quot;Tuyển dụng\\nvà thử việc\&quot; as UC2\n    usecase \&quot;Quản lý hợp đồng\\nvà bảo hiểm\&quot; as UC3\n    usecase \&quot;Quản lý quyết định\\nlương và chức vụ\&quot; as UC4\n    usecase \&quot;Lập kế hoạch\\nphân công\&quot; as UC5\n    usecase \&quot;Tính lương\\nhàng tháng\&quot; as UC6\n    usecase \&quot;Quản lý\\nchấm công\&quot; as UC7\n    usecase \&quot;Quản lý\\ngiờ phụ trội\&quot; as UC8\n    usecase \&quot;Quản lý khen thưởng\\nvà kỷ luật\&quot; as UC9\n    usecase \&quot;Quản lý phiếu\\nthu và chi\&quot; as UC10\n\n    UC1 -[hidden]right- UC2\n    UC2 -[hidden]right- UC3\n    UC3 -[hidden]right- UC4\n    UC4 -[hidden]right- UC5\n    UC5 -[hidden]right- UC6\n\n    UC7 -[hidden]right- UC8\n    UC8 -[hidden]right- UC9\n    UC9 -[hidden]right- UC10\n\n    UC1 -[hidden]down- UC7\n    UC2 -[hidden]down- UC7\n    UC3 -[hidden]down- UC8\n    UC4 -[hidden]down- UC9\n    UC5 -[hidden]down- UC10\n}\n\nNS -- UC1\nNS -- UC2\nNS -- UC3\nNS -- UC4\n\nTP -- UC5\n\nGD -- UC4\nGD -- UC9\n\nBCC -- UC7\nBCC -- UC8\n\nKT -- UC10\nKT -- UC6\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="dBRbkEZpuAqh5RYjev3S-1766">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
