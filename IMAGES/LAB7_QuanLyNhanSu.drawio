        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle Tuyen dung - Hop dong - Bao hiem\n\ntop to bottom direction\nskinparam linetype ortho\nskinparam shadowing false\nskinparam backgroundColor White\nskinparam classAttributeIconSize 0\nskinparam nodesep 55\nskinparam ranksep 75\n\nhide circle\n\nskinparam class {\n    BackgroundColor White\n    HeaderBackgroundColor #EDEDED\n    BorderColor Black\n    ArrowColor Black\n    FontColor Black\n}\n\nclass NhanVien {\n    MaNV: int «PK»\n    HoTen: string\n    NgaySinh: DateTime\n    GioiTinh: string\n    DiaChi: string\n    DienThoai: string\n    CCCD: string\n    NgayVaoLam: DateTime\n    TrangThai: string\n    MaPB: int «FK»\n    --\n    themNhanVien()\n    suaNhanVien()\n    xoaNhanVien()\n    timNhanVien()\n}\n\nclass PhongBan {\n    MaPB: int «PK»\n    TenPB: string\n    DiaDiem: string\n    DienThoai: string\n    MaTruongPhong: int «FK»\n    --\n    themPhongBan()\n    suaPhongBan()\n    xoaPhongBan()\n    layDanhSachNhanVien()\n}\n\nclass QuyetDinhTuyenDung {\n    MaQDTD: int «PK»\n    MaNV: int «FK»\n    MaPB: int «FK»\n    NgayQuyetDinh: DateTime\n    NgayBatDauThuViec: DateTime\n    NgayKetThucThuViec: DateTime\n    LuongThuViec: decimal\n    NoiDung: string\n    NguoiKy: string\n    --\n    lapQuyetDinh()\n    capNhatQuyetDinh()\n    kiemTraThuViec()\n}\n\nclass HopDongLaoDong {\n    MaHD: int «PK»\n    MaNV: int «FK»\n    LoaiHopDong: string\n    NgayKy: DateTime\n    NgayBatDau: DateTime\n    NgayKetThuc: DateTime\n    NoiDung: string\n    TrangThai: string\n    --\n    lapHopDong()\n    giaHanHopDong()\n    chamDutHopDong()\n    kiemTraHieuLuc()\n}\n\nclass BaoHiem {\n    MaBH: int «PK»\n    MaNV: int «FK»\n    SoBHXH: string\n    SoBHYT: string\n    NgayThamGia: DateTime\n    MucDongBHXH: decimal\n    MucDongBHYT: decimal\n    TrangThai: string\n    --\n    dangKyBaoHiem()\n    capNhatBaoHiem()\n    tinhTienBaoHiem()\n}\n\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhTuyenDung\nPhongBan \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhTuyenDung\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; HopDongLaoDong\nNhanVien \&quot;1\&quot; -- \&quot;0..1\&quot; BaoHiem\n\nNhanVien -[hidden]right- PhongBan\nQuyetDinhTuyenDung -[hidden]right- HopDongLaoDong\nHopDongLaoDong -[hidden]right- BaoHiem\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="dBRbkEZpuAqh5RYjev3S-1389">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
