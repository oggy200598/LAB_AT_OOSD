        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle Ke hoach lam viec va cham cong\n\ntop to bottom direction\nskinparam linetype ortho\nskinparam shadowing false\nskinparam backgroundColor White\nskinparam classAttributeIconSize 0\nskinparam nodesep 55\nskinparam ranksep 75\n\nhide circle\n\nskinparam class {\n    BackgroundColor White\n    HeaderBackgroundColor #EDEDED\n    BorderColor Black\n    ArrowColor Black\n    FontColor Black\n}\n\nclass PhongBan {\n    MaPB: int «PK»\n    TenPB: string\n    --\n    layDanhSachNhanVien()\n}\n\nclass NhanVien {\n    MaNV: int «PK»\n    HoTen: string\n    MaPB: int «FK»\n    --\n    timNhanVien()\n}\n\nclass CaLamViec {\n    MaCa: int «PK»\n    TenCa: string\n    GioBatDau: TimeSpan\n    GioKetThuc: TimeSpan\n    --\n    themCaLam()\n    suaCaLam()\n    tinhSoGioLam()\n}\n\nclass KeHoachPhanCong {\n    MaKH: int «PK»\n    MaPB: int «FK»\n    Tuan: int\n    Nam: int\n    NgayLap: DateTime\n    MaNguoiLap: int «FK»\n    TrangThai: string\n    --\n    lapKeHoach()\n    capNhatKeHoach()\n    duyetKeHoach()\n}\n\nclass BangChamCong {\n    MaBCC: int «PK»\n    Thang: int\n    Nam: int\n    NgayLap: DateTime\n    NguoiLap: string\n    TrangThai: string\n    --\n    lapBangChamCong()\n    capNhatChamCong()\n    tongHopNgayCong()\n}\n\nclass ChiTietPhanCong {\n    MaCTPC: int «PK»\n    MaKH: int «FK»\n    MaNV: int «FK»\n    MaCa: int «FK»\n    NgayLamViec: DateTime\n    CoPhuTroiDuKien: bool\n    --\n    phanCongNhanVien()\n    thayDoiCaLam()\n    huyPhanCong()\n}\n\nclass ChiTietChamCong {\n    MaCTCC: int «PK»\n    MaBCC: int «FK»\n    MaNV: int «FK»\n    NgayChamCong: DateTime\n    MaCa: int «FK»\n    SoGioLam: decimal\n    TrangThai: string\n    --\n    ghiNhanChamCong()\n    capNhatGioLam()\n    tinhNgayCong()\n}\n\nPhongBan \&quot;1\&quot; -- \&quot;0..*\&quot; KeHoachPhanCong\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; KeHoachPhanCong : nguoi lap\n\nKeHoachPhanCong \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietPhanCong\nBangChamCong \&quot;1\&quot; *-- \&quot;0..*\&quot; ChiTietChamCong\n\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietPhanCong\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietChamCong\n\nCaLamViec \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietPhanCong\nCaLamViec \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietChamCong\n\nPhongBan -[hidden]right- NhanVien\nCaLamViec -[hidden]right- KeHoachPhanCong\nKeHoachPhanCong -[hidden]right- BangChamCong\nChiTietPhanCong -[hidden]right- ChiTietChamCong\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="dBRbkEZpuAqh5RYjev3S-1524">
