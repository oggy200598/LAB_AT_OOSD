        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle Quan ly nhan vien va phong ban\n\ntop to bottom direction\nskinparam linetype ortho\nskinparam shadowing false\nskinparam backgroundColor White\nskinparam classAttributeIconSize 0\nskinparam nodesep 50\nskinparam ranksep 70\n\nhide circle\n\nskinparam class {\n    BackgroundColor White\n    HeaderBackgroundColor #EDEDED\n    BorderColor Black\n    ArrowColor Black\n    FontColor Black\n}\n\nclass PhongBan {\n    MaPB: int «PK»\n    TenPB: string\n    DiaDiem: string\n    DienThoai: string\n    MaTruongPhong: int «FK»\n    --\n    themPhongBan()\n    suaPhongBan()\n    xoaPhongBan()\n    layDanhSachNhanVien()\n}\n\nclass NhanVien {\n    MaNV: int «PK»\n    HoTen: string\n    NgaySinh: DateTime\n    GioiTinh: string\n    DiaChi: string\n    DienThoai: string\n    CCCD: string\n    NgayVaoLam: DateTime\n    TrangThai: string\n    MaPB: int «FK»\n    --\n    themNhanVien()\n    suaNhanVien()\n    xoaNhanVien()\n    timNhanVien()\n}\n\nclass ChucVu {\n    MaCV: int «PK»\n    TenCV: string\n    MoTa: string\n    PhuCapMacDinh: decimal\n    --\n    themChucVu()\n    suaChucVu()\n    xoaChucVu()\n}\n\nclass QuyetDinhChucVu {\n    MaQDCV: int «PK»\n    MaNV: int «FK»\n    MaCV: int «FK»\n    NgayQuyetDinh: DateTime\n    NgayHieuLuc: DateTime\n    PhuCapChucVu: decimal\n    NoiDung: string\n    NguoiKy: string\n    --\n    lapQuyetDinhChucVu()\n    boNhiemChucVu()\n    dieuChinhPhuCap()\n}\n\nPhongBan \&quot;1\&quot; -- \&quot;0..*\&quot; NhanVien : truong phong\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhChucVu\nChucVu \&quot;1\&quot; -- \&quot;0..*\&quot; QuyetDinhChucVu\n\nNhanVien -[hidden]right- ChucVu\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="dBRbkEZpuAqh5RYjev3S-1329">
          <mxCell connectable="0" parent="dBRbkEZpuAqh5RYjev3S-988" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
