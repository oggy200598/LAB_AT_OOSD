        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\nleft to right direction\nskinparam shadowing false\nskinparam linetype ortho\nskinparam actorStyle stickman\nskinparam packageStyle rectangle\n\nactor \&quot;Khách hàng\&quot; as KH\nactor \&quot;Nhân viên quản lý\&quot; as QL\nactor \&quot;Kế toán\&quot; as KT\nactor \&quot;Nhân viên dịch vụ\&quot; as DV\nactor \&quot;Nhân viên an ninh\&quot; as AN\nactor \&quot;Nhân viên kỹ thuật\&quot; as KY\nactor \&quot;Quản trị viên\&quot; as QT\n\nrectangle \&quot;HỆ THỐNG QUẢN LÝ CHO THUÊ VĂN PHÒNG Ở CAO ỐC\&quot; {\n  usecase \&quot;Đăng nhập hệ thống\&quot; as UC01\n  usecase \&quot;Quản lý tầng\&quot; as UC02\n  usecase \&quot;Quản lý phòng\&quot; as UC03\n  usecase \&quot;Tra cứu phòng trống\&quot; as UC04\n  usecase \&quot;Quản lý khách hàng\&quot; as UC05\n  usecase \&quot;Quản lý hợp đồng\&quot; as UC06\n  usecase \&quot;Quản lý chi tiết hợp đồng\&quot; as UC07\n  usecase \&quot;Quản lý gia hạn\&quot; as UC08\n  usecase \&quot;Quản lý hóa đơn tiền thuê\&quot; as UC09\n  usecase \&quot;Quản lý thanh toán\&quot; as UC10\n  usecase \&quot;Quản lý công nợ\&quot; as UC11\n  usecase \&quot;Quản lý dịch vụ\&quot; as UC12\n  usecase \&quot;Ghi nhận sử dụng dịch vụ\&quot; as UC13\n  usecase \&quot;Quản lý hóa đơn dịch vụ\&quot; as UC14\n  usecase \&quot;Quản lý nhân viên công ty\&quot; as UC15\n  usecase \&quot;Quản lý thẻ giữ xe\&quot; as UC16\n  usecase \&quot;Quản lý kiểm tra phòng\&quot; as UC17\n  usecase \&quot;Quản lý vi phạm\&quot; as UC18\n  usecase \&quot;Thống kê, báo cáo\&quot; as UC19\n  usecase \&quot;Quản lý tài khoản\&quot; as UC20\n  usecase \&quot;Kiểm tra điều kiện gia hạn\&quot; as UC21\n  usecase \&quot;Kiểm tra thời hạn thuê\&quot; as UC22\n  usecase \&quot;Tính tiền trả trước 6 tháng\&quot; as UC23\n}\n\nKH -- UC04\nKH -- UC06\nKH -- UC08\nKH -- UC10\n\nQL -- UC01\nQL -- UC02\nQL -- UC03\nQL -- UC04\nQL -- UC05\nQL -- UC06\nQL -- UC07\nQL -- UC08\nQL -- UC15\n\nKT -- UC01\nKT -- UC09\nKT -- UC10\nKT -- UC11\nKT -- UC14\nKT -- UC18\nKT -- UC19\n\nDV -- UC01\nDV -- UC12\nDV -- UC13\nDV -- UC14\n\nAN -- UC01\nAN -- UC15\nAN -- UC16\n\nKY -- UC01\nKY -- UC17\nKY -- UC18\n\nQT -- UC01\nQT -- UC20\nQT -- UC19\n\nUC06 ..&gt; UC07 : &lt;&lt;include&gt;&gt;\nUC06 ..&gt; UC22 : &lt;&lt;include&gt;&gt;\nUC06 ..&gt; UC23 : &lt;&lt;include&gt;&gt;\nUC08 ..&gt; UC21 : &lt;&lt;include&gt;&gt;\nUC21 ..&gt; UC11 : &lt;&lt;include&gt;&gt;\nUC14 ..&gt; UC13 : &lt;&lt;include&gt;&gt;\nUC10 ..&gt; UC11 : &lt;&lt;include&gt;&gt;\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="BPYXpoyeMRLmNcSQqBXk-736">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
