        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\nhide circle\nskinparam classAttributeIconSize 0\nskinparam linetype ortho\nskinparam shadowing false\ntop to bottom direction\n\nclass \&quot;Tầng\&quot; as Tang {\n  Mã tầng: String\n  Số tầng: Integer\n  Mô tả: String\n  --\n  Thêm tầng()\n  Sửa tầng()\n  Xóa tầng()\n  Lấy danh sách phòng()\n}\n\nclass \&quot;Phòng\&quot; as Phong {\n  Mã phòng: String\n  Mã tầng: String\n  Diện tích: Double\n  Hướng phòng: String\n  Giá thuê: Decimal\n  Trạng thái: String\n  Tình trạng: String\n  --\n  Thêm phòng()\n  Cập nhật phòng()\n  Tính giá thuê()\n  Kiểm tra trạng thái()\n}\n\nclass \&quot;Khách hàng\&quot; as KhachHang {\n  Mã KH: String\n  Tên KH: String\n  Địa chỉ: String\n  Điện thoại: String\n  Email: String\n  Mã số thuế: String\n  Người đại diện: String\n  --\n  Thêm khách hàng()\n  Cập nhật thông tin()\n  Xem hợp đồng()\n}\n\nclass \&quot;Hợp đồng\&quot; as HopDong {\n  Mã HĐ: String\n  Mã KH: String\n  Ngày ký: Date\n  Ngày bắt đầu: Date\n  Ngày kết thúc: Date\n  Tổng tiền thuê: Decimal\n  Tiền trả trước: Decimal\n  Điều khoản: String\n  Trạng thái: String\n  --\n  Lập hợp đồng()\n  Tính tiền trả trước()\n  Kiểm tra thời hạn()\n  Thanh lý hợp đồng()\n}\n\nclass \&quot;Chi tiết hợp đồng\&quot; as CTHD {\n  Mã CTHĐ: String\n  Mã HĐ: String\n  Mã phòng: String\n  Đơn giá thuê: Decimal\n  Ngày bắt đầu: Date\n  Ngày kết thúc: Date\n  --\n  Thêm phòng thuê()\n  Xóa phòng thuê()\n  Tính tiền thuê()\n  Cập nhật thời hạn()\n}\n\nclass \&quot;Phiếu gia hạn\&quot; as GiaHan {\n  Mã PGH: String\n  Mã CTHĐ: String\n  Ngày lập: Date\n  Số tháng gia hạn: Integer\n  Ngày kết thúc mới: Date\n  Trạng thái: String\n  --\n  Lập phiếu gia hạn()\n  Kiểm tra điều kiện()\n  Kiểm tra công nợ()\n  Tính thời hạn mới()\n}\n\nclass \&quot;Hóa đơn tiền thuê\&quot; as HDThue {\n  Mã HĐT: String\n  Mã HĐ: String\n  Kỳ thanh toán: String\n  Ngày lập: Date\n  Hạn thanh toán: Date\n  Tổng tiền: Decimal\n  Trạng thái: String\n  --\n  Lập hóa đơn()\n  Tính tổng tiền()\n  Kiểm tra thanh toán()\n}\n\nclass \&quot;Thanh toán\&quot; as ThanhToan {\n  Mã TT: String\n  Ngày thanh toán: Date\n  Số tiền: Decimal\n  Phương thức: String\n  Loại thanh toán: String\n  Mã HĐT: String\n  Mã HĐDV: String\n  --\n  Ghi nhận thanh toán()\n  Kiểm tra số tiền()\n  In biên lai()\n}\n\nclass \&quot;Dịch vụ\&quot; as DichVu {\n  Mã DV: String\n  Tên dịch vụ: String\n  Đơn giá: Decimal\n  Đơn vị tính: String\n  Mô tả: String\n  --\n  Thêm dịch vụ()\n  Sửa dịch vụ()\n  Xóa dịch vụ()\n  Xem đơn giá()\n}\n\nclass \&quot;Sử dụng dịch vụ\&quot; as SDDV {\n  Mã SDDV: String\n  Mã CTHĐ: String\n  Mã DV: String\n  Tháng: Integer\n  Năm: Integer\n  Số lượng: Double\n  Đơn giá: Decimal\n  --\n  Ghi nhận sử dụng()\n  Cập nhật số lượng()\n  Tính chi phí()\n}\n\nclass \&quot;Hóa đơn dịch vụ\&quot; as HDDV {\n  Mã HĐDV: String\n  Mã HĐ: String\n  Tháng: Integer\n  Năm: Integer\n  Ngày lập: Date\n  Hạn thanh toán: Date\n  Tổng tiền: Decimal\n  Trạng thái: String\n  --\n  Lập hóa đơn dịch vụ()\n  Tính tổng tiền()\n  Kiểm tra thanh toán()\n}\n\nclass \&quot;Chi tiết hóa đơn dịch vụ\&quot; as CTHDDV {\n  Mã CTHĐDV: String\n  Mã HĐDV: String\n  Mã SDDV: String\n  Thành tiền: Decimal\n  --\n  Thêm chi tiết()\n  Tính thành tiền()\n  Xóa chi tiết()\n}\n\nclass \&quot;Nhân viên\&quot; as NhanVien {\n  Mã NV: String\n  Mã KH: String\n  Mã phòng: String\n  Họ tên: String\n  Hình ảnh: String\n  Chức vụ: String\n  Điện thoại: String\n  Trạng thái: String\n  --\n  Thêm nhân viên()\n  Cập nhật thông tin()\n  Chuyển phòng()\n  Xóa nhân viên()\n}\n\nclass \&quot;Thẻ giữ xe\&quot; as TheXe {\n  Mã thẻ: String\n  Mã NV: String\n  Biển số xe: String\n  Loại xe: String\n  Ngày cấp: Date\n  Trạng thái: String\n  --\n  Cấp thẻ()\n  Cập nhật thông tin xe()\n  Khóa thẻ()\n  Hủy thẻ()\n}\n\nclass \&quot;Phiếu kiểm tra\&quot; as KiemTra {\n  Mã PKT: String\n  Mã phòng: String\n  Ngày kiểm tra: Date\n  Tình trạng phòng: String\n  Nội dung: String\n  Kết quả: String\n  --\n  Lập phiếu kiểm tra()\n  Ghi nhận tình trạng()\n  Đề xuất sửa chữa()\n}\n\nclass \&quot;Phiếu vi phạm\&quot; as ViPham {\n  Mã PVP: String\n  Mã CTHĐ: String\n  Mã PKT: String\n  Ngày lập: Date\n  Nội dung vi phạm: String\n  Số tiền phạt: Decimal\n  Trạng thái: String\n  --\n  Lập phiếu vi phạm()\n  Tính tiền phạt()\n  Cập nhật trạng thái()\n}\n\nclass \&quot;Nhân viên quản lý\&quot; as NVQL {\n  Mã NVQL: String\n  Họ tên: String\n  Chức vụ: String\n  Điện thoại: String\n  Email: String\n  --\n  Lập hợp đồng()\n  Lập phiếu gia hạn()\n  Kiểm tra phòng()\n  Lập phiếu vi phạm()\n}\n\nTang \&quot;1\&quot; *-- \&quot;1..*\&quot; Phong\nKhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; HopDong\nHopDong \&quot;1\&quot; *-- \&quot;1..*\&quot; CTHD\nPhong \&quot;1\&quot; -- \&quot;0..*\&quot; CTHD\nCTHD \&quot;1\&quot; -- \&quot;0..*\&quot; GiaHan\n\nHopDong \&quot;1\&quot; -- \&quot;0..*\&quot; HDThue\nHDThue \&quot;1\&quot; -- \&quot;0..*\&quot; ThanhToan\nHopDong \&quot;1\&quot; -- \&quot;0..*\&quot; HDDV\nHDDV \&quot;1\&quot; -- \&quot;0..*\&quot; ThanhToan\n\nDichVu \&quot;1\&quot; -- \&quot;0..*\&quot; SDDV\nCTHD \&quot;1\&quot; -- \&quot;0..*\&quot; SDDV\nHDDV \&quot;1\&quot; *-- \&quot;1..*\&quot; CTHDDV\nSDDV \&quot;1\&quot; -- \&quot;0..1\&quot; CTHDDV\n\nKhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; NhanVien\nPhong \&quot;1\&quot; -- \&quot;0..*\&quot; NhanVien\nNhanVien \&quot;1\&quot; -- \&quot;0..*\&quot; TheXe\n\nPhong \&quot;1\&quot; -- \&quot;0..*\&quot; KiemTra\nKiemTra \&quot;1\&quot; -- \&quot;0..*\&quot; ViPham\nCTHD \&quot;1\&quot; -- \&quot;0..*\&quot; ViPham\n\nNVQL \&quot;1\&quot; -- \&quot;0..*\&quot; HopDong\nNVQL \&quot;1\&quot; -- \&quot;0..*\&quot; GiaHan\nNVQL \&quot;1\&quot; -- \&quot;0..*\&quot; KiemTra\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="BPYXpoyeMRLmNcSQqBXk-467">
