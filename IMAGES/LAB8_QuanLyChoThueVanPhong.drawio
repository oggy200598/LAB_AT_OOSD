        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\nleft to right direction\nskinparam shadowing false\nskinparam linetype ortho\nskinparam actorStyle stickman\nskinparam packageStyle rectangle\n\nactor \&quot;Khách hàng\&quot; as KH\nactor \&quot;Nhân viên quản lý\&quot; as QL\nactor \&quot;Kế toán\&quot; as KT\nactor \&quot;Nhân viên dịch vụ\&quot; as DV\n\nrectangle \&quot;HỆ THỐNG QUẢN LÝ CHO THUÊ VĂN PHÒNG\&quot; {\n  usecase \&quot;Ký hợp đồng thuê\&quot; as UC01\n  usecase \&quot;Lập hợp đồng\&quot; as UC02\n  usecase \&quot;Chọn phòng thuê\&quot; as UC03\n  usecase \&quot;Kiểm tra phòng trống\&quot; as UC04\n  usecase \&quot;Kiểm tra thời hạn thuê\&quot; as UC05\n  usecase \&quot;Tính tiền thuê\&quot; as UC06\n  usecase \&quot;Thanh toán trước 6 tháng\&quot; as UC07\n  usecase \&quot;Lập hóa đơn tiền thuê\&quot; as UC08\n  usecase \&quot;Thanh toán tiền thuê\\nhằng tháng từ tháng 7\&quot; as UC09\n  usecase \&quot;Ghi nhận sử dụng dịch vụ\&quot; as UC10\n  usecase \&quot;Tính tiền dịch vụ\&quot; as UC11\n  usecase \&quot;Lập hóa đơn dịch vụ\&quot; as UC12\n  usecase \&quot;Thanh toán hóa đơn dịch vụ\&quot; as UC13\n  usecase \&quot;Ghi nhận thanh toán\&quot; as UC14\n  usecase \&quot;Kiểm tra công nợ\&quot; as UC15\n  usecase \&quot;In biên lai\&quot; as UC16\n}\n\nKH -- UC01\nKH -- UC07\nKH -- UC09\nKH -- UC13\n\nQL -- UC02\nQL -- UC03\nQL -- UC04\nQL -- UC05\n\nKT -- UC06\nKT -- UC07\nKT -- UC08\nKT -- UC09\nKT -- UC12\nKT -- UC13\nKT -- UC14\nKT -- UC15\n\nDV -- UC10\nDV -- UC11\n\nUC01 ..&gt; UC02 : &lt;&lt;include&gt;&gt;\nUC02 ..&gt; UC03 : &lt;&lt;include&gt;&gt;\nUC03 ..&gt; UC04 : &lt;&lt;include&gt;&gt;\nUC02 ..&gt; UC05 : &lt;&lt;include&gt;&gt;\nUC02 ..&gt; UC06 : &lt;&lt;include&gt;&gt;\n\nUC07 ..&gt; UC08 : &lt;&lt;include&gt;&gt;\nUC07 ..&gt; UC14 : &lt;&lt;include&gt;&gt;\n\nUC09 ..&gt; UC08 : &lt;&lt;include&gt;&gt;\nUC09 ..&gt; UC14 : &lt;&lt;include&gt;&gt;\nUC09 ..&gt; UC15 : &lt;&lt;include&gt;&gt;\n\nUC12 ..&gt; UC10 : &lt;&lt;include&gt;&gt;\nUC12 ..&gt; UC11 : &lt;&lt;include&gt;&gt;\n\nUC13 ..&gt; UC14 : &lt;&lt;include&gt;&gt;\nUC13 ..&gt; UC15 : &lt;&lt;include&gt;&gt;\n\nUC16 ..&gt; UC14 : &lt;&lt;extend&gt;&gt;\n\nnote bottom of UC05\nThời hạn thuê tối thiểu 6 tháng\nend note\n\nnote bottom of UC07\nThanh toán trước 6 tháng đầu tiên\nend note\n\nnote bottom of UC09\nTừ tháng thứ 7\nThanh toán vào đầu mỗi tháng\nend note\n\nnote bottom of UC13\nDịch vụ thanh toán cuối tháng\nnếu có sử dụng\nend note\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="BPYXpoyeMRLmNcSQqBXk-818">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
