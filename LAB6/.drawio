          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\nleft to right direction\nskinparam packageStyle rectangle\nskinparam shadowing false\n\ntitle USE CASE PHAN RA - LAP VA NHAN TOA THUOC\n\nactor \&quot;Bệnh nhân\&quot; as BN\nactor \&quot;Bác sĩ\&quot; as BS\n\nrectangle \&quot;Hệ thống quản lý hồ sơ bệnh án\&quot; {\n  usecase \&quot;Lập toa thuốc\&quot; as UC1\n  usecase \&quot;Xem thông tin phiếu khám\&quot; as UC2\n  usecase \&quot;Xem kết quả xét nghiệm\&quot; as UC3\n  usecase \&quot;Chọn thuốc\&quot; as UC4\n  usecase \&quot;Nhập liều dùng\&quot; as UC5\n  usecase \&quot;Nhập số lượng thuốc\&quot; as UC6\n  usecase \&quot;Nhập tần suất và thời gian dùng\&quot; as UC7\n  usecase \&quot;Ghi lời dặn\&quot; as UC8\n  usecase \&quot;Lưu toa thuốc\&quot; as UC9\n  usecase \&quot;In toa thuốc\&quot; as UC10\n  usecase \&quot;Nhận toa thuốc\&quot; as UC11\n}\n\nBS -- UC1\nBS -- UC10\nBN -- UC11\n\nUC1 ..&gt; UC2 : &lt;&lt;include&gt;&gt;\nUC1 ..&gt; UC4 : &lt;&lt;include&gt;&gt;\nUC1 ..&gt; UC5 : &lt;&lt;include&gt;&gt;\nUC1 ..&gt; UC6 : &lt;&lt;include&gt;&gt;\nUC1 ..&gt; UC7 : &lt;&lt;include&gt;&gt;\nUC1 ..&gt; UC9 : &lt;&lt;include&gt;&gt;\n\nUC3 ..&gt; UC1 : &lt;&lt;extend&gt;&gt;\nUC8 ..&gt; UC1 : &lt;&lt;extend&gt;&gt;\n\nUC11 ..&gt; UC10 : &lt;&lt;include&gt;&gt;\n\nnote bottom of UC3\n  Khi có kết quả xét nghiệm\n  cần tham khảo trước kê toa\nend note\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ZvqWq3Sb1Hvn-_nWz8XI-214">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
