        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\nleft to right direction\nskinparam packageStyle rectangle\nskinparam shadowing false\n\ntitle USE CASE PHAN RA - DANG KY KHAM BENH\n\nactor \&quot;Bệnh nhân\&quot; as BN\nactor \&quot;Nhân viên CSKH\&quot; as CSKH\nactor \&quot;Nhân viên thu ngân\&quot; as TN\n\nrectangle \&quot;Hệ thống quản lý hồ sơ bệnh án\&quot; {\n  usecase \&quot;Đăng ký khám bệnh\&quot; as UC1\n  usecase \&quot;Tra cứu hồ sơ bệnh án\&quot; as UC2\n  usecase \&quot;Đăng ký lần đầu\&quot; as UC3\n  usecase \&quot;Lập phiếu đăng ký\&quot; as UC4\n  usecase \&quot;Thanh toán lệ phí năm\&quot; as UC5\n  usecase \&quot;Cấp hồ sơ bệnh án\&quot; as UC6\n  usecase \&quot;Lập phiếu khám bệnh\&quot; as UC7\n}\n\nBN -- UC1\nBN -- UC5\nCSKH -- UC1\nCSKH -- UC4\nCSKH -- UC6\nCSKH -- UC7\nTN -- UC5\n\nUC1 ..&gt; UC2 : &lt;&lt;include&gt;&gt;\nUC1 ..&gt; UC7 : &lt;&lt;include&gt;&gt;\n\nUC3 ..&gt; UC1 : &lt;&lt;extend&gt;&gt;\nUC3 ..&gt; UC4 : &lt;&lt;include&gt;&gt;\nUC3 ..&gt; UC5 : &lt;&lt;include&gt;&gt;\nUC3 ..&gt; UC6 : &lt;&lt;include&gt;&gt;\n\nnote bottom of UC3\n  Điều kiện: Bệnh nhân\n  chưa có hồ sơ bệnh án\nend note\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ZvqWq3Sb1Hvn-_nWz8XI-125">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
