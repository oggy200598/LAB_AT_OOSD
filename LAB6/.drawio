        <UserObject label="USE CASE PHAN RA - XET NGHIEM" plantUmlId="title_0" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;whiteSpace=wrap;" plantUmlBaseValue="USE CASE PHAN RA - XET NGHIEM" id="ZvqWq3Sb1Hvn-_nWz8XI-213">
          <mxCell parent="ZvqWq3Sb1Hvn-_nWz8XI-185" style="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1">
