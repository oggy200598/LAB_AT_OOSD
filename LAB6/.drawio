        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\nhide circle\n\nclass BenhNhan {\n  maBenhNhan: String\n  hoTen: String\n  ngaySinh: Date\n  diaChi: String\n  soDienThoai: String\n  anh3x4: String\n  dangKyKham()\n  traCuuHoSo()\n}\n\nclass PhieuDangKy {\n  maPhieuDK: String\n  ngayDangKy: Date\n  lePhiNam: Double\n  trangThaiThanhToan: Boolean\n  lapPhieu()\n  xacNhanThanhToan()\n}\n\nclass HoSoBenhAn {\n  maHoSo: String\n  ngayLap: Date\n  trangThai: String\n  taoHoSo()\n  capNhatHoSo()\n  xemLichSu()\n}\n\nclass PhieuKham {\n  maPhieuKham: String\n  ngayGioKham: DateTime\n  trieuChung: String\n  thanNhiet: Double\n  huyetAp: String\n  chanDoan: String\n  taoPhieuKham()\n  capNhatKetQua()\n}\n\nclass BacSi {\n  maBacSi: String\n  hoTen: String\n  chuyenMon: String\n  soDienThoai: String\n  khamBenh()\n  chanDoan()\n  lapToaThuoc()\n}\n\nclass KhoaDieuTri {\n  maKhoa: String\n  tenKhoa: String\n  viTri: String\n  tiepNhanDieuTri()\n}\n\nclass ToaThuoc {\n  maToaThuoc: String\n  ngayLap: Date\n  loiDan: String\n  lapToaThuoc()\n  capNhatToaThuoc()\n}\n\nclass ChiTietToaThuoc {\n  maChiTietToa: String\n  lieuDung: String\n  soLuong: int\n  tanSuat: String\n  thoiGianDung: String\n  capNhatLieuDung()\n}\n\nclass Thuoc {\n  maThuoc: String\n  tenThuoc: String\n  donViTinh: String\n  giaThuoc: Double\n  traCuuThuoc()\n}\n\nclass XetNghiem {\n  maXetNghiem: String\n  tenXetNghiem: String\n  ngayThucHien: DateTime\n  ketQua: String\n  chiDinhXetNghiem()\n  capNhatKetQua()\n}\n\nclass LichHen {\n  maLichHen: String\n  ngayHen: Date\n  gioHen: String\n  loaiKham: String\n  trangThai: String\n  datLichHen()\n  huyLichHen()\n}\n\nclass NhanVienCSKH {\n  maNhanVien: String\n  hoTen: String\n  soDienThoai: String\n  tiepNhanYeuCau()\n  datLichHen()\n}\n\nclass VienPhi {\n  maVienPhi: String\n  ngayThanhToan: DateTime\n  tongTien: Double\n  trangThaiThanhToan: String\n  tinhVienPhi()\n  thanhToan()\n}\n\nBe