        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\nleft to right direction\nskinparam packageStyle rectangle\nskinparam shadowing false\nskinparam linetype ortho\nskinparam actorStyle awesome\n\nactor \&quot;Bệnh nhân\&quot; as BN\nactor \&quot;Bác sĩ\&quot; as BS\nactor \&quot;Nhân viên CSKH\&quot; as CSKH\nactor \&quot;Nhân viên thu ngân\&quot; as TN\nactor \&quot;Nhân viên xét nghiệm\&quot; as XN\nactor \&quot;Quản trị viên\&quot; as QTV\n\nrectangle \&quot;HỆ THỐNG QUẢN LÝ HỒ SƠ BỆNH ÁN\&quot; {\n  usecase \&quot;Quản lý thông tin\\nbệnh nhân\&quot; as UC1\n  usecase \&quot;Đăng ký khám bệnh\&quot; as UC2\n  usecase \&quot;Quản lý lệ phí năm\&quot; as UC3\n  usecase \&quot;Quản lý hồ sơ\\nbệnh án\&quot; as UC4\n  usecase \&quot;Tra cứu lịch sử khám\&quot; as UC5\n  usecase \&quot;Khám bệnh và\\nchẩn đoán\&quot; as UC6\n  usecase \&quot;Chỉ định xét nghiệm\&quot; as UC7\n  usecase \&quot;Thực hiện xét nghiệm\\nvà cập nhật kết quả\&quot; as UC8\n  usecase \&quot;Lập toa thuốc\&quot; as UC9\n  usecase \&quot;Quản lý lịch khám\\nđịnh kỳ\&quot; as UC10\n  usecase \&quot;Thanh toán viện phí\&quot; as UC11\n  usecase \&quot;Hoàn tất đợt điều trị\&quot; as UC12\n  usecase \&quot;Quản lý tài khoản\\nvà danh mục\&quot; as UC13\n}\n\nBN -- UC2\nBN -- UC5\nBN -- UC10\n\nCSKH -- UC1\nCSKH -- UC2\nCSKH -- UC4\nCSKH -- UC10\n\nBS -- UC4\nBS -- UC5\nBS -- UC6\nBS -- UC7\nBS -- UC9\nBS -- UC12\n\nXN -- UC8\n\nTN -- UC3\nTN -- UC11\nTN -- UC12\n\nQTV -- UC13\n\nUC2 ..&gt; UC1 : &lt;&lt;include&gt;&gt;\nUC2 ..&gt; UC3 : &lt;&lt;include&gt;&gt;\nUC6 ..&gt; UC5 : &lt;&lt;include&gt;&gt;\nUC7 ..&gt; UC6 : &lt;&lt;extend&gt;&gt;\nUC9 ..&gt; UC6 : &lt;&lt;extend&gt;&gt;\nUC12 ..&gt; UC11 : &lt;&lt;include&gt;&gt;\n\n@enduml\n\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ZvqWq3Sb1Hvn-_nWz8XI-2">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
