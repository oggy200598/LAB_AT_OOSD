        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\nleft to right direction\nskinparam packageStyle rectangle\nskinparam shadowing false\n\ntitle USE CASE PHAN RA - KHAM BENH\n\nactor \&quot;Bệnh nhân\&quot; as BN\nactor \&quot;Bác sĩ\&quot; as BS\n\nrectangle \&quot;Hệ thống quản lý hồ sơ bệnh án\&quot; {\n  usecase \&quot;Khám bệnh và chẩn đoán\&quot; as UC1\n  usecase \&quot;Tiếp nhận phiếu khám\&quot; as UC2\n  usecase \&quot;Xem lịch sử bệnh án\&quot; as UC3\n  usecase \&quot;Ghi nhận triệu chứng\&quot; as UC4\n  usecase \&quot;Đo thân nhiệt, huyết áp\&quot; as UC5\n  usecase \&quot;Ghi nhận chẩn đoán\&quot; as UC6\n  usecase \&quot;Chỉ định xét nghiệm\&quot; as UC7\n  usecase \&quot;Lập toa thuốc\&quot; as UC8\n}\n\nBN -- UC1\nBS -- UC1\nBS -- UC7\nBS -- UC8\n\nUC1 ..&gt; UC2 : &lt;&lt;include&gt;&gt;\nUC1 ..&gt; UC3 : &lt;&lt;include&gt;&gt;\nUC1 ..&gt; UC4 : &lt;&lt;include&gt;&gt;\nUC1 ..&gt; UC5 : &lt;&lt;include&gt;&gt;\nUC1 ..&gt; UC6 : &lt;&lt;include&gt;&gt;\n\nUC7 ..&gt; UC1 : &lt;&lt;extend&gt;&gt;\nUC8 ..&gt; UC1 : &lt;&lt;extend&gt;&gt;\n\nnote bottom of UC7\n  Chỉ thực hiện khi\n  bác sĩ yêu cầu xét nghiệm\nend note\n\n@enduml\n\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ZvqWq3Sb1Hvn-_nWz8XI-157">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
