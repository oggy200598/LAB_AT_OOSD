        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\nleft to right direction\nskinparam packageStyle rectangle\nskinparam shadowing false\n\ntitle USE CASE PHAN RA - XET NGHIEM\n\nactor \&quot;Bệnh nhân\&quot; as BN\nactor \&quot;Bác sĩ\&quot; as BS\nactor \&quot;Nhân viên xét nghiệm\&quot; as NVXN\n\nrectangle \&quot;Hệ thống quản lý hồ sơ bệnh án\&quot; {\n  usecase \&quot;Xử lý xét nghiệm\&quot; as UC1\n  usecase \&quot;Chỉ định xét nghiệm\&quot; as UC2\n  usecase \&quot;Tạo phiếu xét nghiệm\&quot; as UC3\n  usecase \&quot;Tiếp nhận yêu cầu xét nghiệm\&quot; as UC4\n  usecase \&quot;Thực hiện xét nghiệm\&quot; as UC5\n  usecase \&quot;Cập nhật kết quả xét nghiệm\&quot; as UC6\n  usecase \&quot;Xem kết quả xét nghiệm\&quot; as UC7\n}\n\nBN -- UC5\nBS -- UC1\nBS -- UC2\nBS -- UC7\nNVXN -- UC4\nNVXN -- UC5\nNVXN -- UC6\n\nUC1 ..&gt; UC2 : &lt;&lt;include&gt;&gt;\nUC1 ..&gt; UC3 : &lt;&lt;include&gt;&gt;\nUC1 ..&gt; UC4 : &lt;&lt;include&gt;&gt;\nUC1 ..&gt; UC5 : &lt;&lt;include&gt;&gt;\nUC1 ..&gt; UC6 : &lt;&lt;include&gt;&gt;\nUC1 ..&gt; UC7 : &lt;&lt;include&gt;&gt;\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ZvqWq3Sb1Hvn-_nWz8XI-185">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
