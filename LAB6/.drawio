        <UserObject label="USE CASE PHAN RA - DANG KY KHAM BENH" plantUmlId="title_0" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;whiteSpace=wrap;" plantUmlBaseValue="USE CASE PHAN RA - DANG KY KHAM BENH" id="ZvqWq3Sb1Hvn-_nWz8XI-155">
