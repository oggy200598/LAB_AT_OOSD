        <UserObject label="USE CASE PHAN RA - LAP VA NHAN TOA THUOC" plantUmlId="title_0" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;whiteSpace=wrap;" plantUmlBaseValue="USE CASE PHAN RA - LAP VA NHAN TOA THUOC" id="ZvqWq3Sb1Hvn-_nWz8XI-245">
          <mxCell parent="ZvqWq3Sb1Hvn-_nWz8XI-214" style="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1">
            <mxGeometry height="24" width="359" x="176.25" y="4630" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle ACTIVITY DIAGRAM - DANG KY KHAM DEN NHAN TOA\n\nskinparam backgroundColor white\nskinparam shadowing false\n\n|Bệnh nhân|\nstart\n:Đến đăng ký khám bệnh;\n\n|Nhân viên CSKH|\n:Tiếp nhận thông tin bệnh nhân;\n\n|Hệ thống|\n:Tra cứu hồ sơ bệnh án;\n\nif (Bệnh nhân đã có hồ sơ?) then (Có)\n  :Hiển thị hồ sơ bệnh án;\nelse (Chưa)\n  |Bệnh nhân|\n  :Cung cấp thông tin cá nhân\n  và ảnh 3x4;\n\n  |Nhân viên CSKH|\n  :Lập phiếu đăng ký;\n\n  |Nhân viên thu ngân|\n  :Thu lệ phí quản lý hằng năm;\n\n  |Hệ thống|\n  :Ghi nhận thanh toán;\n  :Tạo hồ sơ bệnh án\n  và cấp mã hồ sơ;\nendif\n\n|Nhân viên CSKH|\n:Lập phiếu khám bệnh;\n\n|Bác sĩ|\n:Tiếp nhận phiếu khám;\n:Xem lịch sử bệnh án;\n:Khám và ghi nhận triệu chứng,\nthân nhiệt, huyết áp;\n:Chẩn đoán ban đầu;\n\nif (Có cần xét nghiệm?) then (Có)\n  :Chỉ định xét nghiệm;\n\n  |Nhân viên xét nghiệm|\n  :Tiếp nhận yêu cầu xét nghiệm;\n  :Thực hiện xét nghiệm;\n  :Cập nhật kết quả xét nghiệm;\n\n  |Hệ thống|\n  :Lưu kết quả vào phiếu khám;\n\n  |Bác sĩ|\n  :Xem kết quả và\n  cập nhật chẩn đoán;\n\nelse (Không)\nendif\n\n|Bác sĩ|\n:Chọn thuốc;\n:Nhập số lượng và liều dùng;\n:Nhập tần suất,\nthời gian sử dụng;\n:Ghi lời dặn sử dụng thuốc;\n\n|Hệ thống|\n:Lưu toa thuốc\nvà chi tiết toa thuốc;\n\n|Bác sĩ|\n:In toa thuốc;\n:Hướng dẫn sử dụng thuốc;\n\n|Bệnh nhân|\n:Nhận toa thuốc;\n\nstop\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ZvqWq3Sb1Hvn-_nWz8XI-247">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
